{
  "name": "cytoscape-graphics-export",
  "version": "2.0.0",
  "description": "Browser SVG, PDF and PNG export for Cytoscape.js",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run check && npm test && npm run build",
    "example": "vite --host 127.0.0.1"
  },
  "peerDependencies": {
    "cytoscape": "3.32.0"
  },
  "dependencies": {
    "canvas2svg": "1.0.16",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@types/cytoscape": "3.21.9",
    "cytoscape": "3.32.0",
    "jsdom": "26.1.0",
    "lodash": "4.17.21",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalySolovyovDev/cytoscape-graphics-export.git"
  }
}
